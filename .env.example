# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_karnataka

# JWT Secret Key for token signing
SECRET_KEY=karnataka_civic_grievance_management_ai_secret_key_2026

# Optional: Google Gemini API Key for multimodal vision verification
# If not set, system automatically falls back to SentenceTransformers + YOLO
GEMINI_API_KEY=your_gemini_api_key_here

# Local AI models
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
YOLO_MODEL=yolov8n.pt
