# ==============================================================================
# CivicAI Karnataka - Comprehensive Git Ignore
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt

# ── Python & Virtual Environments ─────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg
.python-version

# ── Python Bytecode & Cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
eggs/
*.egg
dist/
build/

# ── Python Testing, Typing & Linting ──────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ── Node.js & Frontend Builds ─────────────────────────────────────────────────
node_modules/
.next/
out/
.docusaurus/
.cache/
.parcel-cache/
.turbo/
.vercel
*.tsbuildinfo
next-env.d.ts

# ── Package Manager Logs ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── Database & Storage Files ──────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.dump

# ── Machine Learning Models & Weights ─────────────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.joblib
*.pkl
*.pickle
*.h5
*.keras
*.bin
runs/
wandb/
backend/app/ml_models/*
!backend/app/ml_models/.gitkeep

# ── Project Datasets & Tabular Dumps ──────────────────────────────────────────
*.csv
*.tsv
*.parquet
*.feather

# ── User Uploads & Media ──────────────────────────────────────────────────────
static/uploads/*
!static/uploads/.gitkeep
backend/static/uploads/*
!backend/static/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.temp

# ── IDEs, Editors & OS Metadata ───────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
